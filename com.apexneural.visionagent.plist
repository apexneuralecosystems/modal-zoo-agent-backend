<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.apexneural.visionagent</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Replace with the actual path on the Mac Mini -->
        <string>/Users/Shared/vision-agent/.venv/bin/python</string>
        <string>/Users/Shared/vision-agent/main.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/Shared/vision-agent</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/Shared/vision-agent/logs/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/Shared/vision-agent/logs/launchd-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
