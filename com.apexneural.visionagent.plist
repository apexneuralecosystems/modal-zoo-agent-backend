<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.apexneural.visionagent</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Self-update entrypoint: run.sh reads current_version and launches that
             version's main.py. setup.sh generates this plist with the real path;
             this static copy is for reference. Replace the path if editing by hand. -->
        <string>/bin/sh</string>
        <string>/Users/Shared/vision-agent/run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/Shared/vision-agent</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/Shared/vision-agent/logs/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/Shared/vision-agent/logs/launchd-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
